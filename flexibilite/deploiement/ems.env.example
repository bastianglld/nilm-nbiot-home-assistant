# Copié en /etc/ems/ems.env par installer-ems.sh (droits 600, lisible par le seul compte système « ems »).
# Ne jamais versionner le vrai fichier.
MQTT_PASSWORD=mot_de_passe_du_compte_ems_donne_par_installer-broker.sh
# Offre utilisée pour le planning : Base, HP/HC, Tempo ou Dynamique
EMS_OFFRE=Tempo
# Offre actuelle du foyer, pour les conseils : Base, HP/HC ou Tempo
EMS_OFFRE_ACTUELLE=Base
